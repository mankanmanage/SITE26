---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { site, expertises, manifestoAudio } from '../data/site';
import { films, pad } from '../data/films';

const hasAudio = Boolean(manifestoAudio.bm || manifestoAudio.fr);

// Découpe un texte en mots pour l'effet « les mots s'allument au défilement ».
const words = (text: string) => text.split(' ');

const story = [
  'Mankan est née de ce que nos éducations ont semé en nous : les dimanches autour d’un grand bol de zamai, les Tabaskis en famille, les rituels simples qui forgent une identité.',
  'C’est la manière, pour de jeunes Maliens, d’apporter leur pierre : une contribution sincère, portée par l’espoir, par l’image que nous voulons renvoyer au monde, et surtout par celle que nous voulons rendre à nous-mêmes.',
];

// Ce qui nous anime, à côté du collage « Mankan parle pour vous ».
const drives = [
  { title: 'On parle fort', text: 'Uniquement pour vous, à travers nos campagnes.' },
  { title: 'On rêve loin', text: 'Même les idées les plus folles sont réalisables : nous rendons l’imaginaire réel.' },
  { title: 'On cherche', text: 'Storytelling et recherche culturelle : nous fouillons les récits, les gestes et les mémoires avant de créer.' },
  { title: 'On est authentique', text: 'Enracinés et fiers.' },
];

const values = [
  { n: '01', title: 'Accessible', text: '« An bè ye kelen ye »', tr: 'Nous sommes un.' },
  { n: '02', title: 'Créatif', text: 'Aussi varié que les motifs d’un bogolan.', tr: '' },
  { n: '03', title: 'Culturel', text: 'Enraciné comme un baobab centenaire.', tr: '' },
];

const mission =
  'Rendre votre message aussi visible qu’un grand boubou un jour de fête, aussi audible qu’un djembé, et aussi impactant qu’une bonne dose de piment dans le zamai.';
const missionAccents = ['visible', 'audible', 'impactant'];
---

<Base
  title="À propos — Les griots modernes de votre marque | MANKAN, Bamako"
  description="MANKAN, agence de communication culturelle née à Bamako : storytelling, recherche culturelle, stratégie de marque, films et campagnes. Écoutez notre manifeste en bambara et en français."
>
  <main id="contenu">
    <!-- 1. AN KA KO LA : les mots s'allument au défilement -->
    <section class="histoire">
      <TopBar />
      <div class="histoire__title">
        <span class="label c-jaune">( À propos de nous )</span>
        <h1 class="display shadow-noir" data-reveal>AN KA<br />KO LA*</h1>
        <p class="italic c-jaune histoire__note">* Notre histoire, en bamanankan.</p>
      </div>
      <div class="histoire__text serif" data-words>
        {story.map((p) => <p>{words(p).map((w) => <span class="w">{w} </span>)}</p>)}
        <p class="histoire__cri c-jaune">
          {words('Avant d’être une agence, Mankan est un cri du cœur : ne plus attendre une place, mais la créer.').map((w) => <span class="w">{w} </span>)}
        </p>
      </div>
    </section>

    <!-- 2. ÉCOUTE-MOI : le manifeste en bambara et en français -->
    {
      hasAudio && (
        <section class="ecoute" data-audio>
          <h2 class="display ecoute__title">Laissez-nous amplifier votre message</h2>
          <div class="ecoute__player">
            <button type="button" class="play-dot ecoute__btn" data-audio-toggle aria-label="Écouter le manifeste">
              <svg class="i-play" width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="7,4 20,12 7,20" /></svg>
              <svg class="i-pause" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><line x1="8" y1="5" x2="8" y2="19" /><line x1="16" y1="5" x2="16" y2="19" /></svg>
            </button>
            <div class="ecoute__track">
              <div class="ecoute__line">
                <span class="italic ecoute__name">Écoute-moi — le manifeste Mankan</span>
                <span class="ecoute__time" data-audio-time>00:00</span>
              </div>
              <div class="ecoute__eq" aria-hidden="true">
                {Array.from({ length: 48 }, (_, i) => <span style={`--d:${(i * 37) % 11}`} />)}
              </div>
              <input
                class="ecoute__seek"
                type="range"
                min="0"
                max="100"
                step="0.1"
                value="0"
                aria-label="Position dans l’enregistrement"
                data-audio-seek
              />
            </div>
            <div class="ecoute__langs" role="group" aria-label="Langue">
              {manifestoAudio.bm && (
                <button type="button" data-audio-lang={manifestoAudio.bm} aria-pressed="true">
                  Bambara
                </button>
              )}
              {manifestoAudio.fr && (
                <button type="button" data-audio-lang={manifestoAudio.fr} aria-pressed={manifestoAudio.bm ? 'false' : 'true'}>
                  Français
                </button>
              )}
            </div>
            <audio preload="metadata" src={manifestoAudio.bm || manifestoAudio.fr} data-audio-el />
          </div>
        </section>
      )
    }

    <!-- 3. MANKAN PARLE POUR VOUS : le collage + ce qui nous anime -->
    <section class="parle" aria-label="Ce qui nous anime">
      <figure class="parle__img" data-reveal>
        <img
          src="/images/illustrations/vos-messages-amplifies.webp"
          alt="Un mégaphone : « Mankan amplifie vos messages », nous sommes les griots modernes de votre marque"
          width="944"
          height="1000"
          loading="lazy"
        />
      </figure>
      <ol class="parle__list">
        {
          drives.map((d, i) => (
            <li data-reveal style={`--i:${i}`}>
              <span class="label c-rouge">{pad(i + 1)}</span>
              <h2 class="display parle__title">{d.title}</h2>
              <p class="serif parle__text">{d.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- 4. ARTISAN DE VOTRE MARQUE -->
    <section class="artisan" id="manifeste">
      <div class="artisan__head">
        <span class="label c-rouge">( Manifeste )</span>
        <h2 class="display" data-reveal>ARTISAN DE VOTRE MARQUE</h2>
        <span class="artisan__sig">{site.signature}</span>
      </div>
      <div class="artisan__col" data-reveal style="--i:1">
        <p class="serif artisan__lead">Mankan, c’est plus qu’une agence créative. C’est une voix. Une mémoire. Un souffle.</p>
        <p>
          Nous sommes des griots d’aujourd’hui&nbsp;: nous ne vendons pas du rêve, nous transmettons un
          héritage. Celui qui naît autour du thé, dans les rues de Bamako, dans les histoires de nos
          grands-mères et dans les idées de demain.
        </p>
      </div>
      <div class="artisan__col" data-reveal style="--i:2">
        <p class="serif artisan__lead">Ici, on ne fait pas juste «&nbsp;de la com’&nbsp;».</p>
        <p>
          On tisse des récits, on réveille des imaginaires, on donne du sens aux marques qui veulent
          parler avec sincérité. Du grin au grand écran, de la rue au réseau, on accompagne celles et
          ceux qui veulent faire entendre leur voix&nbsp;: claire, fière, enracinée.
        </p>
      </div>
    </section>

    <!-- 5. NOUS SOMMES : cartes qui se retournent -->
    <section class="valeurs">
      <div class="valeurs__head">
        <h2 class="display">Nous sommes</h2>
        <span class="label">( Survolez les cartes )</span>
      </div>
      <div class="valeurs__grid">
        {
          values.map((v, i) => (
            <button type="button" class="valeur" data-reveal style={`--i:${i}`} aria-pressed="false" data-flip>
              <span class="valeur__inner">
                <span class="valeur__face valeur__front">
                  <span class="valeur__n">{v.n}</span>
                  <span class="display valeur__title">{v.title}</span>
                  <span class="valeur__hint label--sm">Retourner ↻</span>
                </span>
                <span class="valeur__face valeur__back">
                  <span class="italic valeur__text">{v.text}</span>
                  {v.tr && <span class="valeur__tr">{v.tr}</span>}
                </span>
              </span>
            </button>
          ))
        }
      </div>
    </section>

    <!-- 6. MISSION : les mots s'allument au défilement -->
    <section class="mission">
      <span class="label c-jaune">( Notre mission )</span>
      <p class="serif mission__text" data-words>
        {
          words(mission).map((w) => (
            <span class={`w${missionAccents.some((a) => w.startsWith(a)) ? ' w--accent' : ''}`}>{w} </span>
          ))
        }
      </p>
    </section>

    <!-- 7. EXPERTISES : accordéon -->
    <section class="expertises" id="expertises">
      <div class="expertises__head">
        <div>
          <span class="label c-rouge">( Nous imaginons et mettons en œuvre )</span>
          <h2 class="display c-rouge">Expertises</h2>
        </div>
        <span class="label">( 01 — {pad(expertises.length)} )</span>
      </div>
      <div class="expertises__list">
        {
          expertises.map((e, i) => (
            <details class="exp" open={i === 0}>
              <summary>
                <span class="c-rouge exp__n">{pad(i + 1)}</span>
                <span class="exp__title">{e.title}</span>
                <span class="exp__icon" aria-hidden="true" />
              </summary>
              <p class="exp__text">{e.text}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- 8. LA SUITE -->
    <a class="suite" href="/projets/">
      <img src="/images/films/daibin-la-natte.jpg" alt="" aria-hidden="true" loading="lazy" />
      <div class="suite__txt">
        <span class="label--sm c-jaune">( La suite )</span>
        <span class="display suite__title">Assez parlé.<br />Place aux projets.</span>
      </div>
      <span class="suite__cta">( Voir nos {pad(films.length)} projets → )</span>
    </a>

    <!-- 9. APPEL FINAL -->
    <section class="final">
      <h2 class="display shadow-noir final__title" data-reveal>Votre histoire<br />est la prochaine.</h2>
      <a class="final__btn" href="/contact/">Racontez-<br />la-nous →</a>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* Mots qui s'allument au défilement */
  .w {
    opacity: 0.22;
    transition: opacity 250ms ease;
  }
  .w.is-lit {
    opacity: 1;
  }
  :global(html:not(.js)) .w {
    opacity: 1;
  }

  /* 1. Histoire */
  .histoire {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 1fr);
    gap: 36px 64px;
    min-height: 100svh;
    padding: 170px var(--pad) 100px;
    background: var(--rouge);
    color: var(--creme);
  }
  .histoire__title {
    position: sticky;
    top: 120px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-self: start;
  }
  .histoire__title h1 {
    font-size: clamp(88px, 11.8vw, 170px);
    line-height: 0.92;
    text-shadow: 0.06em 0.06em 0 var(--noir);
  }
  .histoire__note {
    font-size: 28px;
  }
  .histoire__text {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 10px;
    font-size: clamp(24px, 2.4vw, 36px);
    line-height: 1.3;
  }
  .histoire__cri {
    font-size: 1.15em;
    font-style: italic;
  }

  /* 2. Écoute */
  .ecoute {
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding: 80px var(--pad);
    background: var(--bleu);
    color: var(--creme);
  }
  .ecoute__title {
    font-size: clamp(24px, 3.2vw, 46px);
    letter-spacing: 0.25em;
    text-align: center;
    text-transform: uppercase;
  }
  .ecoute__player {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 40px;
  }
  .ecoute__btn {
    width: 96px;
    height: 96px;
    border: 0;
    cursor: pointer;
    transition: transform 300ms var(--ease);
  }
  .ecoute__btn:hover {
    transform: scale(1.06);
  }
  .ecoute__btn .i-pause,
  .is-playing .ecoute__btn .i-play {
    display: none;
  }
  .is-playing .ecoute__btn .i-pause {
    display: block;
  }
  .ecoute__track {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .ecoute__line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .ecoute__name {
    font-size: clamp(20px, 2vw, 28px);
  }
  .ecoute__time {
    font-size: 13px;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    color: var(--jaune);
  }
  .ecoute__eq {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 44px;
  }
  .ecoute__eq span {
    flex: 1;
    height: 20%;
    background: rgb(255 247 243 / 0.35);
  }
  .is-playing .ecoute__eq span {
    background: var(--jaune);
    animation: eq 900ms ease-in-out infinite alternate;
    animation-delay: calc(var(--d) * -90ms);
  }
  @keyframes eq {
    from {
      height: 15%;
    }
    to {
      height: 100%;
    }
  }
  .ecoute__seek {
    width: 100%;
    accent-color: var(--jaune);
    cursor: pointer;
  }
  .ecoute__langs {
    display: flex;
    gap: 10px;
  }
  .ecoute__langs button {
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid var(--jaune);
    background: transparent;
    color: var(--creme);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .ecoute__langs button[aria-pressed='true'] {
    background: var(--jaune);
    color: var(--rouge);
  }

  /* 3. Mankan parle pour vous */
  .parle {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px 80px;
    align-items: center;
    padding: 110px var(--pad);
    background: var(--creme);
    color: var(--noir);
  }
  .parle__img {
    position: sticky;
    top: 90px;
    align-self: start;
    margin: 0;
  }
  .parle__img img {
    display: block;
    width: 100%;
    height: auto;
  }
  .parle__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--noir);
  }
  .parle__list li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 34px 0;
    border-top: 1px solid var(--noir);
  }
  .parle__title {
    font-size: clamp(40px, 4.6vw, 72px);
    color: var(--bleu);
    text-transform: uppercase;
  }
  .parle__text {
    max-width: 34ch;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.3;
  }

  /* 4. Artisan */
  .artisan {
    display: grid;
    grid-template-columns: minmax(0, 520px) minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    padding: 110px var(--pad);
    background: var(--creme);
    color: var(--noir);
  }
  .artisan__head {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .artisan__head h2 {
    font-size: clamp(56px, 6.4vw, 92px);
    line-height: 0.98;
    letter-spacing: 0.06em;
    color: var(--bleu);
  }
  .artisan__sig {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--bleu);
  }
  .artisan__col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 34px;
    font-size: 19px;
    line-height: 1.6;
  }
  .artisan__lead {
    font-size: 30px;
    line-height: 1.2;
    color: var(--rouge);
  }

  /* 5. Valeurs : cartes qui se retournent */
  .valeurs {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding: 100px var(--pad);
    background: var(--orange);
    color: var(--creme);
  }
  .valeurs__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .valeurs__head h2 {
    font-size: clamp(56px, 6.7vw, 96px);
  }
  .valeurs__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .valeur {
    height: 320px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    perspective: 1200px;
    cursor: pointer;
  }
  .valeur__inner {
    position: relative;
    display: block;
    height: 100%;
    transition: transform 700ms var(--ease);
    transform-style: preserve-3d;
  }
  .valeur:hover .valeur__inner,
  .valeur[aria-pressed='true'] .valeur__inner {
    transform: rotateY(180deg);
  }
  .valeur__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    backface-visibility: hidden;
  }
  .valeur__front {
    justify-content: space-between;
    border: 1px solid rgb(255 247 243 / 0.4);
  }
  .valeur__back {
    justify-content: center;
    background: var(--rouge);
    transform: rotateY(180deg);
  }
  .valeur__n {
    font-size: 13px;
  }
  .valeur__title {
    font-size: clamp(40px, 3.6vw, 56px);
  }
  .valeur__hint {
    color: var(--gris);
  }
  .valeur__text {
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1.2;
  }
  .valeur__tr {
    font-size: 16px;
    color: var(--jaune);
  }

  /* 6. Mission */
  .mission {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    min-height: 80svh;
    padding: 100px var(--pad);
    background: var(--rouge);
    color: var(--creme);
  }
  .mission__text {
    max-width: 1180px;
    font-size: clamp(32px, 4.2vw, 62px);
    line-height: 1.12;
  }
  .w--accent {
    font-style: italic;
    color: var(--jaune);
  }

  /* 7. Expertises : accordéon */
  .expertises {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 100px var(--pad);
    background: var(--creme);
    color: var(--noir);
  }
  .expertises__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .expertises__head > div {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .expertises__head h2 {
    font-size: clamp(56px, 6.7vw, 96px);
  }
  .expertises__list {
    border-bottom: 1px solid var(--noir);
  }
  .exp {
    border-top: 1px solid var(--noir);
  }
  .exp summary {
    display: grid;
    grid-template-columns: 48px 1fr 32px;
    align-items: center;
    gap: 16px;
    min-height: 76px;
    font-size: clamp(20px, 2vw, 28px);
    cursor: pointer;
    list-style: none;
    transition:
      padding 300ms var(--ease),
      color 300ms var(--ease);
  }
  .exp summary::-webkit-details-marker {
    display: none;
  }
  .exp summary:hover {
    padding-left: 12px;
    color: var(--rouge);
  }
  .exp__n {
    font-size: 13px;
  }
  .exp__icon {
    position: relative;
    width: 24px;
    height: 24px;
  }
  .exp__icon::before,
  .exp__icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    width: 24px;
    height: 2px;
    background: currentColor;
    transition: transform 300ms var(--ease);
  }
  .exp__icon::after {
    transform: rotate(90deg);
  }
  .exp[open] .exp__icon::after {
    transform: rotate(0deg);
  }
  .exp[open] summary {
    color: var(--rouge);
  }
  .exp__text {
    max-width: 60ch;
    padding: 0 0 26px 64px;
    font-size: 18px;
    line-height: 1.55;
    animation: exp-open 400ms var(--ease);
  }
  @keyframes exp-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  /* 8. Suite */
  .suite {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    min-height: 400px;
    padding: 56px var(--pad);
    overflow: hidden;
    background: var(--bleu);
    color: var(--creme);
  }
  .suite:hover {
    color: var(--creme);
  }
  .suite img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    transition:
      opacity 500ms var(--ease),
      transform 900ms var(--ease);
  }
  .suite::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 12 / 0.55), rgb(0 0 12 / 0.1) 70%);
  }
  .suite:hover img {
    opacity: 1;
    transform: scale(1.04);
  }
  .suite__txt,
  .suite__cta {
    position: relative;
    z-index: 1;
  }
  .suite__txt {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .suite__title {
    font-size: clamp(52px, 6.7vw, 96px);
  }
  .suite__cta {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* 9. Final */
  .final {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 40px 64px;
    min-height: 420px;
