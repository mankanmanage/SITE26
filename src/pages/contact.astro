---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const needs = [
  'Film / spot publicitaire',
  'Campagne 360°',
  'Branding & identité',
  'Social media',
  'Conseil & projets spéciaux',
];
const steps = [
  { n: '01', title: 'On vous écoute', text: 'Brief & immersion dans votre univers.' },
  { n: '02', title: 'On vous propose', text: 'Une idée, une stratégie, un devis clair.' },
  { n: '03', title: 'On crée', text: 'Production, livraison, suivi.' },
];
---

<Base
  title="Contact — Travaillons ensemble | MANKAN, agence de communication à Bamako"
  description="Un film, une campagne, une identité ? Contactez MANKAN à Hamdallaye ACI 2000, Bamako : team@mankancommunication.com · +223 77 09 14 09."
>
  <main id="contenu" class="contact">
    <TopBar left={{ label: 'Accueil', href: '/' }} right={{ label: 'À propos', href: '/a-propos/' }} />

    <div class="contact__left">
      <div class="contact__title">
        <h1 class="display c-jaune" data-reveal>AN KA<br />BAARA KAI<br />GNONKON<br />FÈ</h1>
        <p class="contact__tr" data-reveal style="--i:1">( Travaillons ensemble )</p>
      </div>

      <div class="contact__next">
        <span class="label--sm c-rose">( Et ensuite&nbsp;? )</span>
        <ol>
          {
            steps.map((s) => (
              <li>
                <span class="c-jaune contact__n">{s.n}</span>
                <span class="italic contact__step">{s.title}</span>
                <span class="c-rose contact__stxt">{s.text}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="contact__right">
      <dl class="contact__coords">
        <dt>Écrire</dt>
        <dd><a href={`mailto:${site.email}`}><strong>{site.email}</strong></a></dd>
        <dt>Appeler</dt>
        <dd><a href={`tel:${site.phoneHref}`}>{site.phone}</a></dd>
        <dt>Passer</dt>
        <dd>{site.address} — {site.country}</dd>
        <dt>Suivre</dt>
        <dd class="contact__social">
          {site.social.map((s) => <a href={s.url} rel="noopener" target="_blank">{s.label}</a>)}
        </dd>
      </dl>

      <form class="contact__form" action="/contact.php" method="post" id="formulaire">
        <p class="italic contact__intro">Votre succès est notre succès. Racontez-nous votre histoire.</p>

        <div class="form-status" data-form-status="ok" role="status" tabindex="-1" hidden>
          <strong>Merci, votre message est bien parti.</strong> Notre équipe revient vers vous pour échanger
          sur votre projet.
        </div>
        <div class="form-status" data-form-status="erreur" role="alert" tabindex="-1" hidden>
          <strong>L’envoi n’a pas abouti.</strong> Vérifiez les champs ou écrivez-nous à
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </div>

        <div class="contact__row">
          <div class="field">
            <label for="c-nom">Nom &amp; structure</label>
            <input id="c-nom" name="nom" type="text" autocomplete="name" required maxlength="160" />
          </div>
          <div class="field">
            <label for="c-mail">E-mail</label>
            <input id="c-mail" name="email" type="email" autocomplete="email" required maxlength="160" />
          </div>
        </div>
        <div class="field">
          <label for="c-besoin">Votre besoin</label>
          <select id="c-besoin" name="type" required>
            {needs.map((n) => <option>{n}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="c-msg">Votre message</label>
          <textarea id="c-msg" name="description" rows="3" required maxlength="5000"></textarea>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="c-site">Ne pas remplir</label>
          <input id="c-site" name="site_web" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button class="btn btn--jaune contact__send" type="submit">( Envoyer → )</button>
        <p class="c-rose contact__tea">
          Un projet, une idée, une simple question&nbsp;: tout commence par une conversation autour d’un thé.
        </p>
      </form>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .contact {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 580px);
    gap: 64px 80px;
    min-height: 100svh;
    padding: 150px var(--pad-top) 80px;
    background: var(--rouge);
  }
  .c-rose {
    color: var(--rose);
  }
  .contact__left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 64px;
  }
  .contact__title {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 30px;
    max-width: 700px;
  }
  .contact__title h1 {
    font-size: clamp(52px, 6.9vw, 100px);
    line-height: 1.02;
    letter-spacing: 0.16em;
    text-align: right;
  }
  .contact__tr {
    font-size: clamp(16px, 1.7vw, 24px);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .contact__next {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 700px;
  }
  .contact__next ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contact__next li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 12px;
    border-top: 1px solid rgb(255 247 243 / 0.4);
  }
  .contact__n {
    font-size: 12px;
  }
  .contact__step {
    font-size: 24px;
  }
  .contact__stxt {
    font-size: 14px;
    line-height: 1.45;
  }

  .contact__right {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .contact__coords {
    display: grid;
    grid-template-columns: 160px 1fr;
    row-gap: 14px;
    margin: 0;
    font-size: 17px;
    line-height: 1.4;
  }
  .contact__coords dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rose);
    padding-top: 3px;
  }
  .contact__coords dd {
    margin: 0;
  }
  .contact__social {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 28px;
    border-top: 1px solid rgb(255 247 243 / 0.4);
  }
  .contact__intro {
    font-size: 28px;
    line-height: 1.15;
  }
  .contact__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .field input,
  .field select,
  .field textarea {
    min-height: 44px;
    padding: 0 10px;
    border: 0;
    border-bottom: 1px solid var(--creme);
    border-radius: 0;
    background: transparent;
    color: var(--creme);
    font: inherit;
    font-size: 16px;
    transition: border-color 200ms var(--ease);
  }
  .field select {
    padding: 0 6px;
    background: var(--rouge);
  }
  .field textarea {
    padding: 8px 10px;
    resize: vertical;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-bottom: 2px solid var(--jaune);
  }
  .field input:user-invalid,
  .field textarea:user-invalid {
    border-bottom: 2px dashed var(--jaune);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact__send {
    align-self: flex-start;
    min-height: 52px;
    padding: 0 32px;
  }
  .contact__tea {
    font-size: 14px;
    line-height: 1.5;
  }
  .form-status {
    padding: 14px 18px;
    background: var(--jaune);
    color: var(--noir);
    font-size: 15px;
  }
  .form-status strong {
    display: block;
  }
  .form-status a {
    text-decoration: underline;
  }

  @media (max-width: 980px) {
    .contact {
      grid-template-columns: 1fr;
      padding-top: 130px;
    }
    .contact__title {
      align-items: flex-start;
    }
    .contact__title h1 {
      text-align: left;
    }
    .contact__next {
      order: 3;
    }
    .contact__left {
      display: contents;
    }
    .contact__right {
      order: 2;
    }
  }
  @media (max-width: 560px) {
    .contact__row,
    .contact__next ol {
      grid-template-columns: 1fr;
    }
    .contact__coords {
      grid-template-columns: 100px 1fr;
    }
  }
</style>
