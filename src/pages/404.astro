---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
---

<Base title="Page introuvable | MANKAN" description="Cette page n’existe pas ou a été déplacée.">
  <main id="contenu" class="nf">
    <TopBar />
    <span class="label c-jaune">( Erreur 404 )</span>
    <h1 class="display">Cette histoire<br />s’est perdue.</h1>
    <div class="nf__actions">
      <a class="btn btn--jaune" href="/">( Retour à l’accueil → )</a>
      <a class="link-line" href="/films/">Voir nos films</a>
    </div>
  </main>
</Base>

<style>
  .nf {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    min-height: 100svh;
    padding: 140px var(--pad) 80px;
    background: var(--rouge);
  }
  .nf h1 {
    font-size: clamp(56px, 9vw, 130px);
    text-shadow: 0.06em 0.06em 0 var(--noir);
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 36px;
    align-items: center;
  }
</style>
