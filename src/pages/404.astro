---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable | Mankan Communication" description="Cette page n'existe pas ou a été déplacée.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Erreur 404</p>
      <h1 style="color: var(--bleu); margin-bottom: 1.5rem;">Cette page s’est perdue en route.</h1>
      <p class="lead">Elle n’existe pas ou a été déplacée.</p>
      <p style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem">
        <a class="btn" href="/">Retour à l’accueil</a>
        <a class="btn btn--secondary" href="/projets/">Voir nos projets</a>
      </p>
    </div>
  </section>
</Base>
