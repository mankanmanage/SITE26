---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Footer from '../../components/Footer.astro';
import { films, filmTypes, usedTypes, pad } from '../../data/films';
---

<Base
  title="Films, spots et campagnes | MANKAN, production audiovisuelle à Bamako"
  description="Tous les films de MANKAN : spots publicitaires, films de marque, campagnes et photographie, réalisés à Bamako par une agence de communication culturelle."
>
  <main id="contenu">
    <section class="films-head">
      <TopBar />
      <span class="label c-jaune" data-reveal>( Tous nos films — {pad(films.length)} )</span>
      <h1 class="display films-head__title" data-reveal style="--i:1">Nos récits en images</h1>
      <p class="italic films-head__sub" data-reveal style="--i:2">
        Chaque projet commence par une question&nbsp;: qu’avons-nous à raconter, et à qui&nbsp;?
      </p>
      {
        usedTypes.length > 1 && (
          <div class="films-filters" role="group" aria-label="Filtrer les films" data-films-filters>
            <button type="button" data-filter="all" aria-pressed="true">
              Tout <span>{pad(films.length)}</span>
            </button>
            {usedTypes.map((t) => (
              <button type="button" data-filter={t} aria-pressed="false">
                {filmTypes[t].plural} <span>{pad(films.filter((f) => f.type === t).length)}</span>
              </button>
            ))}
          </div>
        )
      }
    </section>

    <ol class="films-list">
      {
        films.map((f, i) => (
          <li data-type={f.type} data-reveal style={`--i:${i % 3}`}>
            <a href={`/films/${f.slug}/`}>
              <span class="films-list__media">
                {f.cover ? (
                  <img src={f.cover} alt={f.coverAlt ?? ''} loading="lazy" />
                ) : f.vimeoId ? (
                  <img data-vimeo-thumb={f.vimeoId} alt="" hidden />
                ) : null}
                {!f.cover && <span class="films-list__blank display">{f.client}</span>}
              </span>
              <span class="films-list__meta">
                <span class="films-list__num c-jaune">{pad(i + 1)}</span>
                <span class="films-list__client">{f.client}</span>
                {!f.title.startsWith('[') && <span class="italic films-list__title">{f.title}</span>}
                <span class="films-list__type label--sm">{filmTypes[f.type].label}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
  <Footer />
</Base>

<style>
  .films-head {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 180px var(--pad) 56px;
  }
  .films-head__title {
    font-size: clamp(56px, 8vw, 120px);
  }
  .films-head__sub {
    max-width: 30ch;
    font-size: clamp(22px, 2vw, 28px);
    color: var(--gris);
  }
  .films-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    margin-top: 24px;
  }
  .films-filters button {
    height: 40px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--gris-2);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .films-filters button span {
    color: var(--jaune);
  }
  .films-filters button[aria-pressed='true'] {
    color: var(--creme);
    border-bottom-color: var(--jaune);
  }

  .films-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr));
    gap: 56px 40px;
    margin: 0;
    padding: 0 var(--pad) 110px;
    list-style: none;
  }
  .films-list li[hidden] {
    display: none;
  }
  .films-list a {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .films-list a:hover {
    color: inherit;
  }
  .films-list__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #12121c;
  }
  .films-list__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }
  .films-list a:hover img {
    transform: scale(1.05);
  }
  .films-list__blank {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    font-size: clamp(36px, 4vw, 56px);
    text-align: center;
    color: rgb(255 247 243 / 0.14);
    background:
      radial-gradient(70% 70% at 80% 20%, rgb(142 23 23 / 0.5), transparent 70%),
      #12121c;
  }
  .films-list__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    padding-top: 12px;
    border-top: 1px solid rgb(255 247 243 / 0.3);
  }
  .films-list__num {
    font-size: 12px;
  }
  .films-list__client {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .films-list__title {
    font-size: 24px;
  }
  .films-list__type {
    margin-left: auto;
    color: var(--gris);
  }
</style>
