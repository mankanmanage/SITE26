---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import LogoMark from '../components/LogoMark.astro';
import { site, clients, verbs } from '../data/site';
import { films, featuredFilms, pad } from '../data/films';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  slogan: site.signature,
  address: { '@type': 'PostalAddress', streetAddress: 'Hamdallaye ACI 2000', addressLocality: 'Bamako', addressCountry: 'ML' },
  sameAs: site.social.map((s) => s.url),
};

// Accueil : uniquement les images / vidéos des films, sans titres.
const heroFilms = films.filter((f) => f.preview || f.cover || f.vimeoId);
const hasPreview = heroFilms.some((f) => f.preview);

// Images cliquables autour de « On fait du bruit pour vous ».
// Modèles provisoires : remplacer `src` (image) et `href` (lien) par les vrais projets.
const manifestoTiles = [
  { src: '/images/films/portrait-gele-dore.jpg', href: '/projets/', label: 'Projet 01', parallax: '0.04' },
  { src: '/images/films/daibin-la-natte.jpg', href: '/projets/daibin-la-natte/', label: 'Daibin', parallax: '-0.03' },
  { src: '/images/films/mariee-voile-blanc.jpg', href: '/projets/', label: 'Projet 03', parallax: '-0.04' },
  { src: '/images/films/serie-orange.jpg', href: '/projets/', label: 'Projet 04', parallax: '0.04' },
  { src: '/images/films/paps-soda.jpg', href: '/projets/paps-soda-le-frigo/', label: 'Pap’s Soda', parallax: '0.05' },
  { src: '/images/films/homme-djembe.jpg', href: '/projets/', label: 'Projet 06', parallax: '-0.05' },
];
---

<Base
  title="MANKAN — Agence de communication culturelle & production à Bamako"
  description="MANKAN, agence de communication culturelle et de production à Bamako : films, spots publicitaires, campagnes 360° et branding. Les griots modernes de votre marque."
  image="/images/films/paps-soda.jpg"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <script is:inline slot="head">
    try {
      if (sessionStorage.getItem('mankan-intro') || matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('no-intro');
    } catch (e) {}
  </script>

  <main id="contenu">
    <!-- ============ HERO : les films en plein écran ============ -->
    <section class="hero" id="top" data-hero>
      <h1 class="visually-hidden">MANKAN, agence de communication culturelle et de production à Bamako</h1>
      <div class="hero__media" aria-hidden="true">
        {
          heroFilms.map((f, i) => (
            <div class={`hero__slide${i === 0 ? ' is-active' : ''}`} data-slide={i}>
              {f.preview ? (
                <video muted loop playsinline preload="none" poster={f.cover} data-src={f.preview} />
              ) : f.cover ? (
                <img class="zoom" src={f.cover} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
              ) : (
                <img class="zoom" data-vimeo-thumb={f.vimeoId} alt="" hidden />
              )}
            </div>
          ))
        }
        <div class="hero__veil"></div>
      </div>

      <a class="hero__logo" href="#top" aria-label="MANKAN — accueil">
        <LogoMark beat />
      </a>

      {
        hasPreview && (
          <button type="button" class="hero__sound" data-sound aria-pressed="false">
            ( Son coupé )
          </button>
        )
      }

      <a class="hero__scroll" href="#decouvrir">( Défiler )<span class="bob"></span></a>

      <!-- Intro : logo animé puis rideau (une fois par visite) -->
      <div class="intro" data-intro aria-hidden="true">
        <div class="intro__logo">
          <span class="intro__sun"></span>
          <img class="intro__word" src="/images/logo/logo-mankan.png" alt="" />
          <img class="intro__rays" src="/images/logo/logo-rayons.png" alt="" />
          <img class="intro__comm" src="/images/logo/logo-communication.png" alt="" />
        </div>
        <span class="intro__sig">{site.signature}</span>
      </div>
    </section>

    <!-- ============ 1. MANIFESTE ============ -->
    <section id="decouvrir" class="manifeste">
      <span class="manifeste__l label c-rouge">( Qui sommes-nous )</span>
      <span class="manifeste__r label">( Bamako — Afrique de l’Ouest )</span>
      {
        manifestoTiles.map((t, i) => (
          <a class={`m-img m-img--${i + 1}`} href={t.href} data-parallax={t.parallax}>
            <img src={t.src} alt="" loading="lazy" />
            <span class="m-img__label">{t.label} →</span>
          </a>
        ))
      }
      <h2 class="manifeste__title display" data-reveal>
        ON FAIT<br /><span class="c-rouge">DU BRUIT</span><br />POUR VOUS
      </h2>
      <p class="manifeste__note italic">Mankan&nbsp;: la voix, le son, en bamanankan.</p>
    </section>

    <!-- ============ 2. À PROPOS ============ -->
    <section class="apropos">
      <span class="label c-rouge">( À propos )</span>
      <div class="apropos__body">
        <p class="serif apropos__text" data-reveal>
          Par le <em class="c-rouge">storytelling</em> et la <em class="c-rouge">recherche culturelle</em>,
          nous façonnons des films, des campagnes et des identités qui font entendre les marques au-delà
          du bruit. Enracinés à Bamako, pensés pour le monde&nbsp;: nous sommes les griots modernes de
          votre marque.
        </p>
        <div class="apropos__actions" data-reveal style="--i:1">
          <a class="btn" href="/a-propos/">( Découvrir l’agence → )</a>
          <a class="link-line" href="/a-propos/#manifeste">Lire notre manifeste</a>
        </div>
      </div>
    </section>

    <!-- ============ 3. PROJETS À LA UNE ============ -->
    <section class="recits">
      <div class="recits__head">
        <div>
          <span class="label c-jaune">( Projets à la une )</span>
          <h2 class="display recits__title" data-reveal>Nos récits</h2>
        </div>
        <span class="label">( 01 — {pad(featuredFilms.length)} )</span>
      </div>
      <div class="recits__grid">
        {
          featuredFilms.map((f, i) => (
            <a class="recit" href={`/projets/${f.slug}/`} data-reveal style={`--i:${i % 2}`}>
              <div class="recit__media">
                {f.cover ? (
                  <img src={f.cover} alt={f.coverAlt ?? ''} loading="lazy" />
                ) : f.vimeoId ? (
                  <img data-vimeo-thumb={f.vimeoId} alt="" hidden />
                ) : null}
                {!f.cover && (
                  <span class="recit__blank display" aria-hidden="true">
                    {f.client}
                  </span>
                )}
              </div>
              {f.tags && (
                <ul class="recit__tags">
                  {f.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
              <h3 class="display">
                {f.client}
                {!f.title.startsWith('[') && <span> — {f.title}</span>}
              </h3>
              {f.description && <p class="italic">{f.description}</p>}
              <span class="recit__cta label">{f.type === 'photo' || f.type === 'branding' ? 'Voir le projet →' : 'Voir le film →'}</span>
            </a>
          ))
        }
      </div>
      <a class="btn btn--pill recits__all" href="/projets/">( Tous nos projets — {pad(films.length)} )</a>
    </section>

    <!-- ============ 4. CE QU'ON FAIT ============ -->
    <section class="verbes">
      <div class="verbes__head">
        <div>
          <span class="label c-jaune">( Ce qu’on fait )</span>
          <h2 class="display shadow-noir verbes__title" data-reveal>Deux verbes</h2>
        </div>
        <span class="italic c-jaune verbes__sub">…et une seule voix&nbsp;: la vôtre.</span>
      </div>
      <ol class="verbes__list">
        {
          verbs.map((v, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a href="/a-propos/#expertises">
                <span class="c-jaune verbes__n">{v.n}</span>
                <span class="verbes__bm">{v.bm}</span>
                <span class="italic verbes__fr">{v.fr}</span>
                <span class="verbes__txt">{v.text}</span>
                <span class="verbes__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ============ 5. CLIENTS ============ -->
    <section class="clients" aria-labelledby="clients-titre">
      <h2 id="clients-titre" class="label c-rouge clients__label">( Ils nous font confiance )</h2>
      <p class="visually-hidden">{clients.join(', ')}</p>
      <div class="clients__viewport" aria-hidden="true">
        <div class="mq clients__track">
          {
            [0, 1].map(() =>
              clients.map((c) => (
                <>
                  <span>{c.toUpperCase()}</span>
                  <span class="clients__dot">●</span>
                </>
              )),
            )
          }
        </div>
      </div>
    </section>

    <!-- ============ 6. APPEL À L'ACTION ============ -->
    <section class="cta">
      <p class="italic cta__q" data-reveal>Vous avez une histoire à raconter&nbsp;?</p>
      <h2 class="display cta__title" data-reveal style="--i:1">ON A LA VOIX.</h2>
      <div class="cta__actions" data-reveal style="--i:2">
        <a class="btn" href="/contact/">( Parlons-en → )</a>
        <a class="link-line cta__mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--bleu);
  }
  .hero__media,
  .hero__slide,
  .hero__veil {
    position: absolute;
    inset: 0;
  }
  .hero__slide {
    opacity: 0;
    transition: opacity 1200ms ease;
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  .hero__slide img,
  .hero__slide video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__veil {
    background: linear-gradient(180deg, rgb(0 0 12 / 0.35), transparent 30%, transparent 70%, rgb(0 0 12 / 0.45));
  }
  .hero__logo,
  .hero__sound,
  .hero__scroll {
    position: absolute;
    z-index: 3;
  }
  .hero__logo {
    left: 50%;
    top: 26px;
    width: 120px;
    transform: translateX(-50%);
  }
  .hero__sound {
    right: var(--pad-top);
    bottom: 36px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--creme);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .hero__scroll {
    left: 50%;
    bottom: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    transform: translateX(-50%);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bob {
    display: block;
    width: 1px;
    height: 44px;
    background: var(--jaune);
    transform-origin: top;
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: scaleY(0.35);
    }
    50% {
      transform: scaleY(1);
    }
  }

  /* Intro */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    background: var(--rouge);
    animation: curtain 0.9s var(--ease-io) 3.2s forwards;
    cursor: pointer;
  }
  :global(.no-intro) .intro {
    display: none;
  }
  .intro__logo {
    position: relative;
    width: min(560px, 80vw);
    aspect-ratio: 844 / 432;
  }
  .intro__logo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .intro__sun {
    position: absolute;
    left: 23%;
    top: -33%;
    width: 84%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--orange);
    animation: sun 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s both;
  }
  .intro__word {
    animation: wipe 0.9s cubic-bezier(0.7, 0, 0.2, 1) 0.5s both;
  }
  .intro__rays {
    transform-origin: 74% 32%;
    animation: burst 1.5s ease-out 1.3s both;
  }
  .intro__comm {
    animation: fadeup 0.6s ease-out 1.7s both;
  }
  .intro__sig {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.3em;
    animation: fadeup 0.6s ease-out 2.1s both;
  }
  @keyframes curtain {
    to {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }
  @keyframes sun {
    from {
      transform: scale(0);
    }
  }
  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes burst {
    0% {
      opacity: 0;
      transform: scale(0.2) rotate(-14deg);
    }
    30% {
      opacity: 1;
      transform: scale(1.2) rotate(0);
    }
    45% {
      transform: scale(1);
    }
    60% {
      transform: scale(1.14);
    }
    72% {
      transform: scale(1);
    }
    86% {
      transform: scale(1.1);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ---------- MANIFESTE ---------- */
  .manifeste {
    position: relative;
    min-height: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 160px var(--pad) 140px;
    overflow: hidden;
    background: var(--creme);
    color: var(--noir);
  }
  .manifeste__l,
  .manifeste__r {
    position: absolute;
    top: 72px;
  }
  .manifeste__l {
    left: var(--pad);
  }
  .manifeste__r {
    right: var(--pad);
  }
  .manifeste__title {
    position: relative;
    z-index: 2;
    font-size: clamp(54px, 10.4vw, 150px);
    line-height: 1.02;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .manifeste__note {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 64px;
    padding: 0 var(--pad);
    font-size: 22px;
    text-align: center;
    color: var(--texte-doux);
  }
  .m-img {
    position: absolute;
    z-index: 3;
    display: block;
    overflow: hidden;
    box-shadow: 0 10px 30px rgb(0 0 12 / 0.18);
    will-change: transform;
  }
  .m-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }
  .m-img__label {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 5px 10px 4px;
    background: var(--jaune);
    color: var(--rouge);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 250ms var(--ease),
      transform 250ms var(--ease);
  }
  .m-img:hover,
  .m-img:focus-visible {
    z-index: 4;
  }
  .m-img:hover img {
    transform: scale(1.08);
  }
  .m-img:hover .m-img__label,
  .m-img:focus-visible .m-img__label {
    opacity: 1;
    transform: none;
  }
  .m-img--1 {
    left: 5%;
    top: 130px;
    width: 180px;
    height: 230px;
    rotate: -6deg;
  }
  .m-img--2 {
    right: 7%;
    top: 120px;
    width: 230px;
    height: 160px;
    rotate: 5deg;
  }
  .m-img--3 {
    left: 9%;
    bottom: 100px;
    width: 170px;
    height: 210px;
    rotate: 4deg;
  }
  .m-img--4 {
    right: 9%;
    bottom: 110px;
    width: 240px;
    height: 170px;
    rotate: -4deg;
  }
  .m-img--5 {
    left: 26%;
    top: 70px;
    width: 150px;
    height: 110px;
    rotate: 3deg;
  }
  .m-img--6 {
    right: 27%;
    bottom: 60px;
    width: 150px;
    height: 190px;
    rotate: -3deg;
  }

  /* ---------- À PROPOS ---------- */
  .apropos {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 64px;
    padding: 110px var(--pad);
    border-top: 1px solid rgb(0 0 12 / 0.12);
    background: var(--creme);
    color: var(--noir);
  }
  .apropos > .label {
    padding-top: 14px;
  }
  .apropos__body {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .apropos__text {
    font-size: clamp(30px, 3.75vw, 54px);
    line-height: 1.12;
  }
  .apropos__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 40px;
    align-items: center;
  }
  .apropos .link-line:hover {
    color: var(--rouge);
  }

  /* ---------- RÉCITS ---------- */
  .recits {
    display: flex;
    flex-direction: column;
    gap: 60px;
    padding: 110px var(--pad);
  }
  .recits__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .recits__head > div {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .recits__title {
    font-size: clamp(64px, 7.6vw, 110px);
  }
  .recits__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px 48px;
  }
  .recit {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .recit:hover {
    color: inherit;
  }
  .recit__media {
    position: relative;
    height: clamp(240px, 28vw, 400px);
    overflow: hidden;
    background: #1a1a5e;
  }
  .recit__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }
  .recit:hover .recit__media img {
    transform: scale(1.05);
  }
  .recit__blank {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    font-size: clamp(40px, 5vw, 72px);
    text-align: center;
    color: rgb(255 247 243 / 0.14);
    background:
      radial-gradient(70% 70% at 80% 20%, rgb(142 23 23 / 0.5), transparent 70%),
      #1a1a5e;
  }
  .recit__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .recit__tags li {
    padding: 6px 12px 5px;
    border: 1px solid rgb(255 247 243 / 0.5);
    border-radius: 999px;
  }
  .recit h3 {
    font-size: clamp(32px, 3vw, 44px);
    line-height: 1.05;
  }
  .recit p {
    font-size: clamp(20px, 1.7vw, 24px);
    line-height: 1.3;
    color: #e6dfdc;
  }
  .recit__cta {
    font-weight: 600;
    color: var(--jaune);
    transition: letter-spacing 300ms var(--ease);
  }
  .recit:hover .recit__cta {
    letter-spacing: 0.24em;
  }
  .recits__all {
    align-self: center;
  }

  /* ---------- VERBES ---------- */
  .verbes {
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding: 100px var(--pad);
    background: var(--rouge);
  }
  .verbes__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
  }
  .verbes__head > div {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .verbes__title {
    font-size: clamp(56px, 6.7vw, 96px);
  }
  .verbes__sub {
    font-size: 26px;
  }
  .verbes__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid rgb(255 247 243 / 0.4);
  }
  .verbes__list a {
    display: grid;
    grid-template-columns: 60px 320px 1fr 360px 40px;
    gap: 24px;
    align-items: center;
    min-height: 118px;
    border-top: 1px solid rgb(255 247 243 / 0.4);
    transition: padding 300ms var(--ease);
  }
  .verbes__list a:hover {
    padding-left: 16px;
  }
  .verbes__n {
    font-size: 13px;
  }
  .verbes__bm {
    font-size: clamp(36px, 3.6vw, 52px);
    font-weight: 600;
  }
  .verbes__fr {
    font-size: clamp(24px, 2.2vw, 32px);
  }
  .verbes__txt {
    font-size: 15px;
    line-height: 1.5;
  }
  .verbes__arrow {
    font-size: 28px;
    text-align: right;
  }

  /* ---------- CLIENTS ---------- */
  .clients {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 56px 0;
    overflow: hidden;
    background: var(--creme);
    color: var(--bleu);
  }
  .clients__label {
    margin: 0;
    padding: 0 var(--pad);
    font-weight: 400;
  }
  .clients__track {
    gap: 56px;
    padding-right: 56px;
    font-family: var(--f-display);
    font-size: clamp(40px, 4vw, 58px);
    white-space: nowrap;
  }
  .clients__dot {
    color: var(--orange);
  }

  /* ---------- CTA ---------- */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    min-height: 700px;
