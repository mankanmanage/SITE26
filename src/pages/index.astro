---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import LogoMark from '../components/LogoMark.astro';
import { site, clients, verbs, team } from '../data/site';
import { films, featuredFilms, filmTypes, usedTypes, pad } from '../data/films';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  slogan: site.signature,
  address: { '@type': 'PostalAddress', streetAddress: 'Hamdallaye ACI 2000', addressLocality: 'Bamako', addressCountry: 'ML' },
  sameAs: site.social.map((s) => s.url),
};

const heroFilms = films.map((f, i) => ({ ...f, num: pad(i + 1), typeLabel: filmTypes[f.type].label }));
const hasPreview = films.some((f) => f.preview);
---

<Base
  title="MANKAN — Agence de communication culturelle & production à Bamako"
  description="MANKAN, agence de communication culturelle et de production à Bamako : films, spots publicitaires, campagnes 360° et branding. Les griots modernes de votre marque."
  image="/images/films/paps-soda.jpg"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <script is:inline slot="head">
    try {
      if (sessionStorage.getItem('mankan-intro') || matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('no-intro');
    } catch (e) {}
  </script>

  <main id="contenu">
    <!-- ============ HERO : index des films ============ -->
    <section class="hero" id="top" data-hero>
      <div class="hero__media" aria-hidden="true">
        {
          heroFilms.map((f, i) => (
            <div class={`hero__slide${i === 0 ? ' is-active' : ''}`} data-slide={i}>
              {f.preview ? (
                <video muted loop playsinline preload="none" poster={f.cover} data-src={f.preview} />
              ) : f.cover ? (
                <img class="zoom" src={f.cover} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
              ) : f.vimeoId ? (
                <img class="zoom" data-vimeo-thumb={f.vimeoId} alt="" hidden />
              ) : (
                <div class="hero__blank">
                  <span class="display">{f.client}</span>
                </div>
              )}
            </div>
          ))
        }
        <div class="hero__veil"></div>
      </div>

      <header class="hero__info">
        <div>
          <span class="hero__brand">MANKAN</span>
          <h1>Agence culturelle<br />&amp; production</h1>
        </div>
        <div class="hide-sm">
          <span>Bamako, Mali</span>
          <span class="muted">{team.map((m) => m.name).join(' · ')}</span>
        </div>
        <ul class="hide-md muted">
          <li>Films &amp; spots</li>
          <li>Campagnes 360°</li>
          <li>Branding</li>
          <li>Photographie</li>
        </ul>
      </header>

      <a class="hero__logo" href="#top" aria-label="MANKAN — accueil">
        <LogoMark beat />
      </a>

      <nav class="hero__nav" aria-label="Navigation principale">
        <ul class="hide-md">
          {usedTypes.map((t) => <li><a href={`/films/?type=${t}`}>{filmTypes[t].plural}</a></li>)}
        </ul>
        <ul class="hero__nav-main">
          <li><a href="/a-propos/">À propos</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li class="hide-sm"><a href={site.social[0].url} rel="noopener" target="_blank">Instagram</a></li>
        </ul>
      </nav>

      <div class="hero__center">
        <a class="italic" href="/a-propos/">Qui sont les griots derrière ces images&nbsp;? →</a>
        <a class="hero__mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>

      <div class="hero__index">
        {
          usedTypes.length > 1 && (
            <div class="hero__filters" role="group" aria-label="Filtrer les projets">
              <button type="button" data-filter="all" aria-pressed="true">
                Tout <span>{pad(films.length)}</span>
              </button>
              {usedTypes.map((t) => (
                <button type="button" data-filter={t} aria-pressed="false">
                  {filmTypes[t].plural} <span>{pad(films.filter((f) => f.type === t).length)}</span>
                </button>
              ))}
            </div>
          )
        }
        <ol class="hero__rows">
          {
            heroFilms.map((f, i) => (
              <li data-row={i} data-type={f.type} class={i === 0 ? 'is-active' : ''}>
                <a href={`/films/${f.slug}/`}>
                  <span class="row__num">{f.num}</span>
                  <span class="row__client">{f.client}</span>
                  <span class="row__title italic">{f.title}</span>
                  <span class="row__cta">Voir →</span>
                  <span class="row__track" aria-hidden="true"><span class="row__bar" /></span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="hero__now">
        <div class="hero__now-meta">
          <span data-now-type>{heroFilms[0].typeLabel}</span>
          {hasPreview && (
            <button type="button" data-sound aria-pressed="false">( Son coupé )</button>
          )}
        </div>
        <span class="hero__timecode display" data-timecode aria-hidden="true">00:00:00</span>
        <a class="hero__play" href={`/films/${heroFilms[0].slug}/`} data-now-link>
          <span class="play-dot" style="width:40px;height:40px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="7,4 20,12 7,20" /></svg>
          </span>
          Voir le film
        </a>
      </div>

      <a class="hero__scroll" href="#decouvrir">( Défiler )<span class="bob"></span></a>

      <!-- Intro : logo animé puis rideau (une fois par visite) -->
      <div class="intro" data-intro aria-hidden="true">
        <div class="intro__logo">
          <span class="intro__sun"></span>
          <img class="intro__word" src="/images/logo/logo-mankan.png" alt="" />
          <img class="intro__rays" src="/images/logo/logo-rayons.png" alt="" />
          <img class="intro__comm" src="/images/logo/logo-communication.png" alt="" />
        </div>
        <span class="intro__sig">{site.signature}</span>
      </div>
    </section>

    <!-- ============ 1. MANIFESTE ============ -->
    <section id="decouvrir" class="manifeste">
      <span class="manifeste__l label c-rouge">( Qui sommes-nous )</span>
      <span class="manifeste__r label">( Bamako — Afrique de l’Ouest )</span>
      <img class="m-img m-img--1" src="/images/films/portrait-gele-dore.jpg" alt="" loading="lazy" data-parallax="0.04" />
      <img class="m-img m-img--2" src="/images/films/daibin-la-natte.jpg" alt="" loading="lazy" data-parallax="-0.03" />
      <img class="m-img m-img--3" src="/images/films/mariee-voile-blanc.jpg" alt="" loading="lazy" data-parallax="-0.04" />
      <img class="m-img m-img--4" src="/images/films/serie-orange.jpg" alt="" loading="lazy" data-parallax="0.04" />
      <h2 class="manifeste__title display" data-reveal>
        ON DONNE<br /><span class="c-rouge">DU MANKAN*</span><br />À VOS MARQUES
      </h2>
      <p class="manifeste__note italic">* mankan&nbsp;: la voix, le son, en bamanankan.</p>
    </section>

    <!-- ============ 2. À PROPOS ============ -->
    <section class="apropos">
      <span class="label c-rouge">( À propos )</span>
      <div class="apropos__body">
        <p class="serif apropos__text" data-reveal>
          Nous façonnons des <em class="c-rouge">films</em>, des <em class="c-rouge">campagnes</em>
          et des <em class="c-rouge">identités</em> qui font entendre les marques au-delà du bruit. Enracinés à
          Bamako, pensés pour le monde&nbsp;: nous sommes les griots modernes de votre marque.
        </p>
        <div class="apropos__actions" data-reveal style="--i:1">
          <a class="btn" href="/a-propos/">( Découvrir l’agence → )</a>
          <a class="link-line" href="/a-propos/#manifeste">Lire notre manifeste</a>
        </div>
      </div>
    </section>

    <!-- ============ 3. PROJETS À LA UNE ============ -->
    <section class="recits">
      <div class="recits__head">
        <div>
          <span class="label c-jaune">( Projets à la une )</span>
          <h2 class="display recits__title" data-reveal>Nos récits</h2>
        </div>
        <span class="label">( 01 — {pad(featuredFilms.length)} )</span>
      </div>
      <div class="recits__grid">
        {
          featuredFilms.map((f, i) => (
            <a class="recit" href={`/films/${f.slug}/`} data-reveal style={`--i:${i % 2}`}>
              <div class="recit__media">
                {f.cover ? (
                  <img src={f.cover} alt={f.coverAlt ?? ''} loading="lazy" />
                ) : f.vimeoId ? (
                  <img data-vimeo-thumb={f.vimeoId} alt="" hidden />
                ) : null}
                {!f.cover && (
                  <span class="recit__blank display" aria-hidden="true">
                    {f.client}
                  </span>
                )}
              </div>
              {f.tags && (
                <ul class="recit__tags">
                  {f.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
              <h3 class="display">
                {f.client}
                {!f.title.startsWith('[') && <span> — {f.title}</span>}
              </h3>
              {f.description && <p class="italic">{f.description}</p>}
              <span class="recit__cta label">{f.type === 'photo' || f.type === 'branding' ? 'Voir le projet →' : 'Voir le film →'}</span>
            </a>
          ))
        }
      </div>
      <a class="btn btn--pill recits__all" href="/films/">( Tous nos films — {pad(films.length)} )</a>
    </section>

    <!-- ============ 4. CE QU'ON FAIT ============ -->
    <section class="verbes">
      <div class="verbes__head">
        <div>
          <span class="label c-jaune">( Ce qu’on fait )</span>
          <h2 class="display shadow-noir verbes__title" data-reveal>Trois verbes</h2>
        </div>
        <span class="italic c-jaune verbes__sub">…et une seule voix&nbsp;: la vôtre.</span>
      </div>
      <ol class="verbes__list">
        {
          verbs.map((v, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a href="/a-propos/#expertises">
                <span class="c-jaune verbes__n">{v.n}</span>
                <span class="verbes__bm">{v.bm}</span>
                <span class="italic verbes__fr">{v.fr}</span>
                <span class="verbes__txt">{v.text}</span>
                <span class="verbes__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ============ 5. CLIENTS ============ -->
    <section class="clients" aria-labelledby="clients-titre">
      <h2 id="clients-titre" class="label c-rouge clients__label">( Ils nous font confiance )</h2>
      <p class="visually-hidden">{clients.join(', ')}</p>
      <div class="clients__viewport" aria-hidden="true">
        <div class="mq clients__track">
          {
            [0, 1].map(() =>
              clients.map((c) => (
                <>
                  <span>{c.toUpperCase()}</span>
                  <span class="clients__dot">●</span>
                </>
              )),
            )
          }
        </div>
      </div>
    </section>

    <!-- ============ 6. APPEL À L'ACTION ============ -->
    <section class="cta">
      <p class="italic cta__q" data-reveal>Vous avez une histoire à raconter&nbsp;?</p>
      <h2 class="display cta__title" data-reveal style="--i:1">ON A LA VOIX.</h2>
      <div class="cta__actions" data-reveal style="--i:2">
        <a class="btn" href="/contact/">( Parlons-en → )</a>
        <a class="link-line cta__mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: var(--noir);
    font-size: 13px;
    line-height: 1.55;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero__media,
  .hero__slide,
  .hero__veil {
    position: absolute;
    inset: 0;
  }
  .hero__slide {
    opacity: 0;
    transition: opacity 900ms ease;
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  .hero__slide img,
  .hero__slide video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__blank {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(60% 60% at 70% 40%, rgb(142 23 23 / 0.55), transparent 70%),
      radial-gradient(50% 50% at 20% 80%, rgb(35 35 124 / 0.6), transparent 70%),
      var(--noir);
  }
  .hero__blank span {
    font-size: clamp(64px, 14vw, 220px);
    color: rgb(255 247 243 / 0.08);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero__veil {
    background: rgb(0 0 12 / 0.38);
  }

  .hero__info,
  .hero__nav,
  .hero__logo,
  .hero__index,
  .hero__now,
  .hero__center,
  .hero__scroll {
    position: absolute;
    z-index: 3;
  }
  .hero ul,
  .hero ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero__info {
    left: var(--pad-top);
    top: 36px;
    display: grid;
    grid-template-columns: 180px 190px 150px;
    gap: 28px;
  }
  .hero__info > div {
    display: flex;
    flex-direction: column;
  }
  .hero__brand {
    font-weight: 600;
  }
  .hero__info h1 {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.55;
  }
  .muted {
    color: var(--gris);
  }
  .hero__logo {
    left: 50%;
    top: 30px;
    width: 120px;
    transform: translateX(-50%);
  }
  .hero__nav {
    right: var(--pad-top);
    top: 36px;
    display: grid;
    grid-template-columns: 150px 130px;
    gap: 28px;
  }
  .hero__nav-main {
    text-align: right;
  }
  .hero__center {
    left: 0;
    right: 0;
    top: 108px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    pointer-events: none;
    text-transform: none;
    letter-spacing: 0;
  }
  .hero__center a {
    pointer-events: auto;
  }
  .hero__center .italic {
    padding: 6px 0;
    font-size: 22px;
  }
  .hero__mail {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--gris);
  }

  .hero__index {
    left: var(--pad-top);
    bottom: 40px;
    width: min(620px, calc(100% - 2 * var(--pad-top)));
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hero__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }
  .hero__filters button {
    height: 32px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--gris-2);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .hero__filters button span {
    color: var(--jaune);
  }
  .hero__filters button[aria-pressed='true'] {
    color: var(--creme);
    border-bottom-color: var(--jaune);
  }
  .hero__rows li[hidden] {
    display: none;
  }
  .hero__rows a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 4px 0 6px;
    opacity: 0.45;
    transition: opacity 300ms ease;
  }
  .hero__rows a:hover {
    color: inherit;
  }
  .hero__rows .is-active a,
  .hero__rows a:focus-visible {
    opacity: 1;
  }
  .row__num {
    width: 22px;
    flex-shrink: 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--jaune);
  }
  .row__client {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }
  .row__title {
    overflow: hidden;
    font-size: 24px;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .row__cta {
    margin-left: auto;
    flex-shrink: 0;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--jaune);
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .is-active .row__cta {
    opacity: 1;
  }
  .row__track {
    position: absolute;
    left: 36px;
    right: 0;
    bottom: 0;
    height: 2px;
  }
  .is-active .row__track {
    background: rgb(255 247 243 / 0.25);
  }
  .row__bar {
    display: block;
    width: 0;
    height: 2px;
    background: var(--jaune);
  }
  .is-active .row__bar {
    width: var(--progress, 0%);
    transition: width 1s linear;
  }

  .hero__now {
    right: var(--pad-top);
    bottom: 40px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
  }
  .hero__now-meta {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--gris);
  }
  .hero__now-meta button {
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--creme);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .hero__timecode {
    font-size: 64px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }
  .hero__play {
    display: flex;
    white-space: nowrap;
    align-items: center;
    gap: 12px;
    padding: 8px 20px 8px 8px;
    border: 1px solid rgb(255 247 243 / 0.6);
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: 0.14em;
    transition:
      background 250ms var(--ease),
      color 250ms var(--ease);
  }
  .hero__play:hover {
    background: var(--creme);
    color: var(--noir);
  }
  .hero__scroll {
    left: 50%;
    bottom: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    transform: translateX(-50%);
    font-size: 11px;
    letter-spacing: 0.18em;
  }
  .bob {
    display: block;
    width: 1px;
    height: 44px;
    background: var(--jaune);
    transform-origin: top;
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: scaleY(0.35);
    }
    50% {
      transform: scaleY(1);
    }
  }

  /* Intro */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    background: var(--rouge);
    animation: curtain 0.9s var(--ease-io) 3.2s forwards;
    cursor: pointer;
  }
  :global(.no-intro) .intro {
    display: none;
  }
  .intro__logo {
    position: relative;
    width: min(560px, 80vw);
    aspect-ratio: 844 / 432;
  }
  .intro__logo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .intro__sun {
    position: absolute;
    left: 23%;
    top: -33%;
    width: 84%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--orange);
    animation: sun 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s both;
  }
  .intro__word {
    animation: wipe 0.9s cubic-bezier(0.7, 0, 0.2, 1) 0.5s both;
  }
  .intro__rays {
    transform-origin: 74% 32%;
    animation: burst 1.5s ease-out 1.3s both;
  }
  .intro__comm {
    animation: fadeup 0.6s ease-out 1.7s both;
  }
  .intro__sig {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.3em;
    animation: fadeup 0.6s ease-out 2.1s both;
  }
  @keyframes curtain {
    to {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }
  @keyframes sun {
    from {
      transform: scale(0);
    }
  }
  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes burst {
    0% {
      opacity: 0;
      transform: scale(0.2) rotate(-14deg);
    }
    30% {
      opacity: 1;
      transform: scale(1.2) rotate(0);
    }
    45% {
      transform: scale(1);
    }
    60% {
      transform: scale(1.14);
    }
    72% {
      transform: scale(1);
    }
    86% {
      transform: scale(1.1);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ---------- MANIFESTE ---------- */
  .manifeste {
    position: relative;
    min-height: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 160px var(--pad) 140px;
    overflow: hidden;
    background: var(--creme);
    color: var(--noir);
  }
  .manifeste__l,
  .manifeste__r {
    position: absolute;
    top: 72px;
  }
  .manifeste__l {
    left: var(--pad);
  }
  .manifeste__r {
    right: var(--pad);
  }
  .manifeste__title {
    position: relative;
    z-index: 2;
    font-size: clamp(54px, 10.4vw, 150px);
    line-height: 1.02;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .manifeste__note {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 64px;
    padding: 0 var(--pad);
    font-size: 22px;
    text-align: center;
