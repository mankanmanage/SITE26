---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import LogoMark from '../components/LogoMark.astro';
import { site, clients, verbs } from '../data/site';
import { films, filmTypes, pad } from '../data/films';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  slogan: site.signature,
  address: { '@type': 'PostalAddress', streetAddress: 'Hamdallaye ACI 2000', addressLocality: 'Bamako', addressCountry: 'ML' },
  sameAs: site.social.map((s) => s.url),
};

// Accueil : uniquement les images / vidéos des films, sans titres.
const heroFilms = films.filter((f) => f.preview || f.cover || f.vimeoId);
const hasPreview = heroFilms.some((f) => f.preview);

// Images cliquables autour de « On fait du bruit pour vous ».
// Modèles provisoires : remplacer `src` (image) et `href` (lien) par les vrais projets.
const manifestoTiles = [
  { src: '/images/photos/portrait-gele-dore-hd.jpg', href: '/projets/', label: 'Projet 01', parallax: '0.04' },
  { src: '/images/films/sanu-edito.jpg', href: '/projets/sanu-edito/', label: 'SÀNU', parallax: '-0.03' },
  { src: '/images/photos/arche-voiles.jpg', href: '/projets/', label: 'Projet 03', parallax: '-0.04' },
  { src: '/images/photos/femme-jaune.jpg', href: '/projets/', label: 'Projet 04', parallax: '0.04' },
  { src: '/images/films/paps-soda-le-frigo.jpg', href: '/projets/paps-soda-le-frigo/', label: 'Pap’s Soda', parallax: '0.05' },
  { src: '/images/photos/homme-blanc.jpg', href: '/projets/', label: 'Projet 06', parallax: '-0.05' },
  { src: '/images/films/leila.jpg', href: '/projets/leila/', label: 'Leila', parallax: '0.06' },
  { src: '/images/photos/femme-indigo.jpg', href: '/projets/', label: 'Projet 08', parallax: '-0.06' },
  { src: '/images/films/mobilite-verte-lancement.jpg', href: '/projets/mobilite-verte-lancement/', label: 'Mobilité Verte', parallax: '0.03' },
  { src: '/images/photos/mariee-noir-blanc.jpg', href: '/projets/', label: 'Projet 10', parallax: '-0.03' },
];
---

<Base
  title="MANKAN — Agence de communication culturelle & production à Bamako"
  description="MANKAN, agence de communication culturelle et de production à Bamako : films, spots publicitaires, campagnes 360° et branding. Les griots modernes de votre marque."
  image="/images/films/paps-soda-le-frigo.jpg"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <script is:inline slot="head">
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('no-intro');
    } catch (e) {}
  </script>

  <main id="contenu">
    <!-- ============ HERO : les films en plein écran ============ -->
    <section class="hero" id="top" data-hero>
      <h1 class="visually-hidden">MANKAN, agence de communication culturelle et de production à Bamako</h1>
      <div class="hero__media" aria-hidden="true">
        {
          heroFilms.map((f, i) => (
            <div class={`hero__slide${i === 0 ? ' is-active' : ''}`} data-slide={i} data-orient={f.previewAlt ? 'both' : f.vertical ? 'vertical' : 'horizontal'}>
              {f.preview && f.cover && <img class="hero__bg" src={f.cover} alt="" loading="lazy" />}
              {f.preview ? (
                <video
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={f.cover}
                  data-src={f.preview}
                  data-src-alt={f.previewAlt}
                  data-alt-when={f.vertical ? 'landscape' : 'portrait'}
                />
              ) : f.cover ? (
                <img class="zoom" src={f.cover} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
              ) : (
                <img class="zoom" data-vimeo-thumb={f.vimeoId} alt="" hidden />
              )}
            </div>
          ))
        }
        <div class="hero__veil"></div>
      </div>

      <a class="hero__logo" href="#top" aria-label="MANKAN — accueil">
        <LogoMark beat />
      </a>

      {
        hasPreview && (
          <button type="button" class="hero__sound" data-sound aria-pressed="false">
            ( Son coupé )
          </button>
        )
      }

      <a class="hero__scroll" href="#decouvrir">( Défiler )<span class="bob"></span></a>

      <!-- Intro : logo animé puis rideau, avant la lecture des films -->
      <div class="intro" data-intro aria-hidden="true">
        <div class="intro__logo">
          <span class="intro__sun"></span>
          <img class="intro__word" src="/images/logo/logo-mankan.png" alt="" />
          <img class="intro__rays" src="/images/logo/logo-rayons.png" alt="" />
          <img class="intro__comm" src="/images/logo/logo-communication.png" alt="" />
        </div>
        <span class="intro__sig">{site.signature}</span>
      </div>
    </section>

    <!-- ============ 1. MANIFESTE ============ -->
    <section id="decouvrir" class="manifeste">
      <span class="manifeste__l label c-rouge">( Qui sommes-nous )</span>
      <span class="manifeste__r label">( Bamako — Afrique de l’Ouest )</span>
      {
        manifestoTiles.map((t, i) => (
          <a class={`m-img m-img--${i + 1}`} href={t.href} data-parallax={t.parallax}>
            <img src={t.src} alt="" loading="lazy" />
            <span class="m-img__label">{t.label} →</span>
          </a>
        ))
      }
      <div class="manifeste__waves" aria-hidden="true"><span></span><span></span><span></span></div>
      <h2 class="manifeste__title display" data-reveal>
        ON FAIT<br /><span class="c-rouge manifeste__bruit">DU BRUIT</span><br />POUR VOUS
      </h2>
      <p class="manifeste__note italic">Mankan&nbsp;: la voix, le son, en bamanankan.</p>
    </section>

    <!-- ============ 2. À PROPOS ============ -->
    <section class="apropos">
      <span class="label c-rouge">( À propos )</span>
      <div class="apropos__body">
        <p class="serif apropos__text" data-reveal>
          Par le <em class="c-rouge">storytelling</em> et la <em class="c-rouge">recherche culturelle</em>,
          nous façonnons des films, des campagnes et des identités qui font entendre les marques au-delà
          du bruit. Enracinés à Bamako, pensés pour le monde&nbsp;: nous sommes les griots modernes de
          votre marque.
        </p>
        <div class="apropos__actions" data-reveal style="--i:1">
          <a class="btn" href="/a-propos/">( Découvrir l’agence → )</a>
          <a class="link-line" href="/a-propos/#manifeste">Lire notre manifeste</a>
        </div>
      </div>
    </section>

    <!-- ============ 3. NOS RÉCITS : carrousel visuel ============ -->
    <section class="recits" aria-labelledby="recits-titre">
      <div class="recits__head">
        <div>
          <span class="label c-rouge">( Projets à la une )</span>
          <h2 id="recits-titre" class="display recits__title" data-reveal>Nos récits</h2>
        </div>
        <div class="recits__nav">
          <span class="label recits__count" data-carousel-count>01 / {pad(films.length)}</span>
          <button type="button" class="recits__arrow" data-carousel-prev aria-label="Projet précédent">←</button>
          <button type="button" class="recits__arrow" data-carousel-next aria-label="Projet suivant">→</button>
        </div>
      </div>

      <ol class="carousel" data-carousel>
        {
          films.map((f, i) => (
            <li class={`slide${f.vertical ? ' slide--vertical' : ''}`}>
              <button type="button" class="slide__btn" data-open-dialog={`recit-${f.slug}`} aria-haspopup="dialog">
                <span class="slide__media">
                  {f.cover && <img src={f.cover} alt="" loading={i < 3 ? 'eager' : 'lazy'} draggable="false" />}
                  {f.preview && <video muted loop playsinline preload="none" data-src={f.preview} aria-hidden="true" />}
                </span>
                <span class="slide__label">
                  <span class="slide__n c-jaune">{pad(i + 1)}</span>
                  <span class="slide__client">{f.client}</span>
                  <span class="slide__more">Découvrir +</span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>

      <a class="btn btn--pill recits__all" href="/projets/">( Tous nos projets — {pad(films.length)} )</a>

      {
        films.map((f) => (
          <dialog id={`recit-${f.slug}`} class="recit-dialog" aria-labelledby={`recit-${f.slug}-titre`}>
            <div class="recit-dialog__inner">
              <button type="button" class="recit-dialog__close" data-close-dialog aria-label="Fermer">×</button>
              <div class={`recit-dialog__media${f.vertical ? ' is-vertical' : ''}`}>
                {f.preview ? (
                  <video muted loop playsinline preload="none" poster={f.cover} data-src={f.preview} aria-hidden="true" />
                ) : (
                  f.cover && <img src={f.cover} alt="" loading="lazy" />
                )}
              </div>
              <div class="recit-dialog__body">
                <span class="label c-jaune">{filmTypes[f.type].label}</span>
                <h3 id={`recit-${f.slug}-titre`} class="display recit-dialog__client">{f.client}</h3>
                {!f.title.startsWith('[') && <p class="italic recit-dialog__title">{f.title}</p>}
                {f.tags && (
                  <ul class="recit__tags">
                    {f.tags.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
                {f.description && <p class="serif recit-dialog__desc">{f.description}</p>}
                {f.brief && (
                  <div class="recit-dialog__block">
                    <span class="label--sm">Le brief</span>
                    <p>{f.brief}</p>
                  </div>
                )}
                {f.response && (
                  <div class="recit-dialog__block">
                    <span class="label--sm">Notre réponse</span>
                    <p>{f.response}</p>
                  </div>
                )}
                <a class="btn btn--jaune recit-dialog__cta" href={`/projets/${f.slug}/`}>
                  ( Voir le film → )
                </a>
              </div>
            </div>
          </dialog>
        ))
      }
    </section>

    <!-- ============ 4. CE QU'ON FAIT ============ -->
    <section class="verbes">
      <div class="verbes__head">
        <div>
          <span class="label c-jaune">( Ce qu’on fait )</span>
          <h2 class="display shadow-noir verbes__title" data-reveal>Deux verbes</h2>
        </div>
        <span class="italic c-jaune verbes__sub">…et une seule voix&nbsp;: la vôtre.</span>
      </div>
      <ol class="verbes__list">
        {
          verbs.map((v, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a href="/a-propos/#expertises">
                <span class="c-jaune verbes__n">{v.n}</span>
                <span class="verbes__bm">{v.bm}</span>
                <span class="italic verbes__fr">{v.fr}</span>
                <span class="verbes__txt">{v.text}</span>
                <span class="verbes__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ============ 5. CLIENTS ============ -->
    <section class="clients" aria-labelledby="clients-titre">
      <h2 id="clients-titre" class="label c-rouge clients__label">( Ils nous font confiance )</h2>
      <p class="visually-hidden">{clients.join(', ')}</p>
      <div class="clients__viewport" aria-hidden="true">
        <div class="mq clients__track">
          {
            [0, 1].map(() =>
              clients.map((c) => (
                <>
                  <span>{c.toUpperCase()}</span>
                  <span class="clients__dot">●</span>
                </>
              )),
            )
          }
        </div>
      </div>
    </section>

    <!-- ============ 6. APPEL À L'ACTION ============ -->
    <section class="cta">
      <img class="cta__illus" src="/images/illustrations/mankan-parle-pour-vous.webp" alt="Collage : une bouche ouverte d’où sort « Mankan parle pour vous »" loading="lazy" />
      <p class="italic cta__q" data-reveal>Vous avez une histoire à raconter&nbsp;?</p>
      <h2 class="display cta__title" data-reveal style="--i:1">ON A LA VOIX.</h2>
      <div class="cta__actions" data-reveal style="--i:2">
        <a class="btn" href="/contact/">( Parlons-en → )</a>
        <a class="link-line cta__mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--bleu);
    color: var(--creme);
  }
  .hero__media,
  .hero__slide,
  .hero__veil {
    position: absolute;
    inset: 0;
  }
  .hero__slide {
    opacity: 0;
    transition: opacity 1200ms ease;
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  .hero__slide img,
  .hero__slide video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Vidéo verticale sur un écran en largeur : affichée en entier, sur un fond flouté.
     Les vidéos horizontales remplissent toujours l’écran. */
  .hero__bg {
    display: none;
    filter: blur(28px) saturate(1.15);
    transform: scale(1.15);
  }
  @media (orientation: landscape) {
    .hero__slide[data-orient='vertical'] .hero__bg {
      display: block;
    }
    .hero__slide[data-orient='vertical'] video {
      object-fit: contain;
    }
  }
  .hero__veil {
    background: linear-gradient(180deg, rgb(0 0 12 / 0.18), transparent 22%, transparent 78%, rgb(0 0 12 / 0.25));
  }
  .hero__logo,
  .hero__sound,
  .hero__scroll {
    position: absolute;
    z-index: 3;
  }
  .hero__logo {
    left: 50%;
    top: 26px;
    width: 120px;
    transform: translateX(-50%);
  }
  .hero__sound {
    right: var(--pad-top);
    bottom: 36px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--creme);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .hero__scroll {
    left: 50%;
    bottom: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    transform: translateX(-50%);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bob {
    display: block;
    width: 1px;
    height: 44px;
    background: var(--jaune);
    transform-origin: top;
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: scaleY(0.35);
    }
    50% {
      transform: scaleY(1);
    }
  }

  /* Intro */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    background: var(--rouge);
    animation: curtain 0.9s var(--ease-io) 3.2s forwards;
    cursor: pointer;
  }
  :global(.no-intro) .intro {
    display: none;
  }
  .intro__logo {
    position: relative;
    width: min(560px, 80vw);
    aspect-ratio: 844 / 432;
  }
  .intro__logo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .intro__sun {
    position: absolute;
    left: 23%;
    top: -33%;
    width: 84%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--orange);
    animation: sun 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s both;
  }
  .intro__word {
    animation: wipe 0.9s cubic-bezier(0.7, 0, 0.2, 1) 0.5s both;
  }
  .intro__rays {
    transform-origin: 74% 32%;
    animation: burst 1.5s ease-out 1.3s both;
  }
  .intro__comm {
    animation: fadeup 0.6s ease-out 1.7s both;
  }
  .intro__sig {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.3em;
    animation: fadeup 0.6s ease-out 2.1s both;
  }
  @keyframes curtain {
    to {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }
  @keyframes sun {
    from {
      transform: scale(0);
    }
  }
  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes burst {
    0% {
      opacity: 0;
      transform: scale(0.2) rotate(-14deg);
    }
    30% {
      opacity: 1;
      transform: scale(1.2) rotate(0);
    }
    45% {
      transform: scale(1);
    }
    60% {
      transform: scale(1.14);
    }
    72% {
      transform: scale(1);
    }
    86% {
      transform: scale(1.1);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ---------- MANIFESTE ---------- */
  .manifeste {
    position: relative;
    min-height: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 160px var(--pad) 140px;
    overflow: hidden;
    background: var(--creme);
    color: var(--noir);
  }
  .manifeste__l,
  .manifeste__r {
    position: absolute;
    top: 72px;
  }
  .manifeste__l {
    left: var(--pad);
  }
  .manifeste__r {
    right: var(--pad);
  }
  .manifeste__title {
    position: relative;
    z-index: 2;
    font-size: clamp(54px, 10.4vw, 150px);
    line-height: 1.02;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .manifeste__note {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 64px;
    padding: 0 var(--pad);
    font-size: 22px;
    text-align: center;
    color: var(--texte-doux);
  }
  .m-img {
    position: absolute;
    z-index: 3;
    display: block;
    overflow: hidden;
    animation: m-float 5s ease-in-out infinite alternate;
    box-shadow: 0 10px 30px rgb(0 0 12 / 0.18);
    will-change: transform;
  }
  .m-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }
  .m-img__label {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 5px 10px 4px;
    background: var(--jaune);
    color: var(--rouge);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 250ms var(--ease),
      transform 250ms var(--ease);
  }
  .m-img:hover,
  .m-img:focus-visible {
    z-index: 4;
  }
  .m-img:hover img {
    transform: scale(1.08);
  }
  .m-img:hover .m-img__label,
  .m-img:focus-visible .m-img__label {
    opacity: 1;
    transform: none;
  }
  .m-img:nth-of-type(2n) {
    animation-duration: 6.5s;
    animation-delay: -2s;
  }
  .m-img:nth-of-type(3n) {
    animation-duration: 7.5s;
    animation-delay: -4s;
  }
  @keyframes m-float {
    from {
      translate: 0 -8px;
    }
    to {
      translate: 0 10px;
    }
  }
  /* Ondes sonores derrière le titre */
  .manifeste__waves {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    width: min(70vw, 760px);
    aspect-ratio: 1;
    translate: -50% -50%;
    pointer-events: none;
  }
  .manifeste__waves span {
    position: absolute;
    inset: 0;
    border: 3px solid var(--rouge);
    border-radius: 50%;
    opacity: 0;
    animation: m-wave 4.5s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  }
  .manifeste__waves span:nth-child(2) {
    animation-delay: 1.5s;
  }
  .manifeste__waves span:nth-child(3) {
    animation-delay: 3s;
  }
  @keyframes m-wave {
    0% {
      opacity: 0.6;
      transform: scale(0.25);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }
  /* « DU BRUIT » qui vibre */
  .manifeste__bruit {
    display: inline-block;
    animation: m-buzz 3.2s ease-in-out infinite;
  }
  @keyframes m-buzz {
    0%,
    82%,
    100% {
      transform: none;
    }
    85% {
      transform: translateX(-4px) rotate(-1.2deg);
    }
    88% {
      transform: translateX(4px) rotate(1.2deg);
    }
    91% {
      transform: translateX(-3px) rotate(-0.8deg);
    }
    94% {
      transform: translateX(2px) rotate(0.5deg);
    }
  }
  .m-img--1 {
    left: 5%;
    top: 130px;
    width: 180px;
    height: 230px;
    rotate: -6deg;
  }
  .m-img--2 {
    right: 7%;
    top: 120px;
    width: 230px;
    height: 160px;
    rotate: 5deg;
  }
  .m-img--3 {
    left: 9%;
    bottom: 100px;
    width: 170px;
    height: 210px;
    rotate: 4deg;
  }
  .m-img--4 {
    right: 9%;
    bottom: 110px;
    width: 240px;
    height: 170px;
    rotate: -4deg;
  }
  .m-img--5 {
    left: 26%;
    top: 70px;
    width: 150px;
    height: 110px;
    rotate: 3deg;
  }
  .m-img--6 {
    right: 27%;
    bottom: 14px;
    width: 140px;
    height: 170px;
    rotate: -3deg;
  }

  .m-img--7 {
    left: 2%;
    top: 440px;
    width: 130px;
    height: 175px;
    rotate: 5deg;
  }
  .m-img--8 {
    right: 2%;
    top: 360px;
    width: 150px;
    height: 200px;
    rotate: -6deg;
  }
  .m-img--9 {
    left: 24%;
    bottom: 36px;
    width: 140px;
    height: 95px;
