---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Rays from '../components/Rays.astro';
import { site, expertises } from '../data/site';

// Équipe : biographies, fonctions et portraits à fournir (brief, section About).
// Exemple : { name: 'Prénom Nom', role: 'Fonction', photo: '/images/equipe/prenom-nom.webp', bio: '…' }
const team: { name: string; role: string; photo?: string; bio?: string }[] = [];
---

<Base
  title="L'agence : les griots modernes de votre marque | Mankan Communication"
  description="Mankan Communication, agence de communication à Bamako où la stratégie rencontre la création : stratégie de marque, identité visuelle, contenus et digital."
  headerTone="bleu"
>
  <section class="about-hero section section--bleu">
    <div class="container">
      <p class="eyebrow" data-reveal>About</p>
      <h1 data-reveal style="--i:1">Mankan, les griots modernes de votre marque.</h1>
      <p class="lead" data-reveal style="--i:2">
        Une agence de communication où la stratégie rencontre la création et notre signature
        culturelle.
      </p>
      <Rays class="about-hero__rays" />
    </div>
  </section>

  <!-- Présentation & conviction -->
  <section class="section">
    <div class="container two-cols">
      <div data-reveal>
        <h2>Notre histoire</h2>
        <p>
          Mankan est née de la rencontre de trois jeunes ambitieux, avec l’envie de raconter
          autrement. Nous accompagnons les marques dans leur communication en associant réflexion
          stratégique, création visuelle et connaissance des réalités locales.
        </p>
      </div>
      <div data-reveal style="--i:1">
        <h2>Notre conviction</h2>
        <p>
          Une marque devient mémorable lorsqu’elle trouve une expression juste. Nous prenons le temps
          de comprendre son histoire, son public et ses ambitions pour imaginer une communication qui
          a du sens.
        </p>
      </div>
    </div>
  </section>

  <!-- Expertises -->
  <section class="section section--creme-2" aria-labelledby="exp-titre">
    <div class="container">
      <p class="eyebrow" data-reveal>Expertises</p>
      <h2 id="exp-titre" class="about-h2" data-reveal style="--i:1">Ce que nous faisons.</h2>
      <ul class="exp-list">
        {
          expertises.map((e, i) => (
            <li data-reveal style={`--i:${i % 3}`}>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Équipe -->
  {
    team.length > 0 && (
      <section class="section" aria-labelledby="equipe-titre">
        <div class="container">
          <p class="eyebrow" data-reveal>Équipe</p>
          <h2 id="equipe-titre" class="about-h2" data-reveal style="--i:1">
            Les visages de Mankan.
          </h2>
          <ul class="team">
            {team.map((m, i) => (
              <li data-reveal style={`--i:${i % 3}`}>
                {m.photo && <img src={m.photo} alt={`Portrait de ${m.name}`} loading="lazy" />}
                <h3>{m.name}</h3>
                <p class="team__role">{m.role}</p>
                {m.bio && <p>{m.bio}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Signature -->
  <section class="section signature">
    <div class="container">
      <p class="signature__text quote" data-reveal>« {site.signature} »</p>
      <p class="signature__tr" data-reveal style="--i:1">{site.signatureTranslation}</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .about-hero {
    position: relative;
    overflow: hidden;
  }
  .about-hero h1 {
    max-width: 16ch;
    margin-bottom: 2rem;
  }
  .about-hero .lead {
    max-width: 40ch;
  }
  .about-hero :global(.about-hero__rays) {
    position: absolute;
    right: var(--gutter);
    bottom: 2rem;
    font-size: clamp(5rem, 14vw, 12rem);
  }
  .two-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .two-cols h2,
  .about-h2 {
    color: var(--bleu);
    margin-bottom: 1.5rem;
  }
  .about-h2 {
    margin-bottom: 3rem;
  }
  .exp-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .exp-list li {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid rgb(35 35 124 / 0.25);
    transition: padding var(--t) var(--ease);
  }
  .exp-list li:hover {
    padding-left: 1rem;
  }
  .exp-list li:last-child {
    border-bottom: 1px solid rgb(35 35 124 / 0.25);
  }
  .exp-list h3 {
    color: var(--bleu);
  }
  .exp-list p {
    margin: 0;
  }
  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2rem;
  }
  .team img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 1rem;
  }
  .team__role {
    color: var(--rouge);
    font-weight: 500;
  }
  .signature {
    text-align: center;
  }
  .signature__text {
    max-width: none;
    margin: 0 auto;
    font-size: clamp(2.25rem, 5vw + 1rem, 5.5rem);
    line-height: 1.05;
    color: var(--rouge);
  }
  .signature__tr {
    margin: 1.5rem auto 0;
    font-size: 1.25rem;
  }
  @media (max-width: 760px) {
    .two-cols,
    .exp-list li {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
