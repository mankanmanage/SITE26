---
// Signe dessiné inspiré des traits du logo. Décoratif, à remplacer par les
// « highlighters » officiels de la charte dès réception des fichiers.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={`rays ${className}`} viewBox="0 0 120 110" aria-hidden="true" focusable="false">
  <g fill="currentColor">
    <path d="M8 60 C 18 42, 34 18, 44 6 C 48 2, 54 4, 52 10 C 44 24, 26 48, 14 64 C 10 68, 4 66, 8 60 Z" />
    <path d="M40 54 L 70 30 C 74 27, 78 30, 74 34 L 44 58 C 41 60, 37 57, 40 54 Z" />
    <path d="M46 80 L 100 44 C 108 40, 114 46, 106 52 L 52 86 C 46 90, 40 85, 46 80 Z" />
    <path d="M70 90 L 104 86 C 110 86, 110 92, 104 92 L 70 94 C 66 94, 66 90, 70 90 Z" />
    <path d="M62 102 L 112 104 C 118 105, 118 110, 112 110 L 62 106 C 58 105, 58 101, 62 102 Z" />
  </g>
</svg>

<style>
  .rays {
    width: 1em;
    height: auto;
    color: var(--orange);
  }
</style>
