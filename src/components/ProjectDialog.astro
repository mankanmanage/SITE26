---
import type { Project } from '../data/projects';
import { categories } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const categoryLabel = categories.find((c) => c.id === project.category)?.label;
const titleId = `projet-${project.slug}-titre`;
---

<dialog
  id={`projet-${project.slug}`}
  class="project-dialog"
  data-hash={project.slug}
  aria-labelledby={titleId}
>
  <div class="project-dialog__inner">
    <button type="button" class="dialog-close" data-close-dialog aria-label="Fermer et revenir aux projets">×</button>

    <header class="project-dialog__head">
      <p class="eyebrow">{categoryLabel}{project.tagline && ` · ${project.tagline}`}</p>
      <h2 id={titleId}>{project.title}</h2>
      <p class="project-dialog__client">{project.client}</p>
    </header>

    {
      project.vimeoId ? (
        <div class="project-dialog__video" data-vimeo-player={project.vimeoId} data-title={project.title} />
      ) : (
        project.cover && <img class="project-dialog__cover" src={project.cover} alt="" loading="lazy" />
      )
    }

    <div class="project-dialog__body">
      {
        project.context && (
          <section>
            <h3>Contexte</h3>
            <p>{project.context}</p>
          </section>
        )
      }
      {
        project.response && (
          <section>
            <h3>Réponse créative</h3>
            <p>{project.response}</p>
          </section>
        )
      }
      {
        project.deliverables && project.deliverables.length > 0 && (
          <section>
            <h3>Livrables</h3>
            <ul>
              {project.deliverables.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </section>
        )
      }
      {
        project.credits && (
          <section>
            <h3>Crédits</h3>
            <p>{project.credits}</p>
          </section>
        )
      }
    </div>

    <div class="project-dialog__foot">
      <button type="button" class="btn btn--secondary" data-close-dialog>← Tous les projets</button>
      <a class="btn" href="/contact/#devis">Demander un devis</a>
    </div>
  </div>
</dialog>

<style>
  .project-dialog {
    width: min(1100px, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--creme);
    color: var(--noir);
  }
  .project-dialog[open] {
    animation: dialog-in var(--t) var(--ease);
  }
  .project-dialog::backdrop {
    background: rgb(0 0 12 / 0.8);
  }
  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .project-dialog__inner {
    position: relative;
    padding: clamp(1.25rem, 4vw, 3rem);
  }
  .project-dialog__head {
    padding-right: 3rem;
    margin-bottom: 2rem;
  }
  .project-dialog__head h2 {
    color: var(--bleu);
  }
  .project-dialog__client {
    margin: 0.75rem 0 0;
    font-weight: 500;
  }
  .project-dialog__video {
    aspect-ratio: 16 / 9;
    background: var(--noir);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .project-dialog__video :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .project-dialog__cover {
    width: 100%;
    border-radius: var(--radius);
  }
  .project-dialog__body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }
  .project-dialog__body h3 {
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rouge);
    margin-bottom: 0.75rem;
  }
  .project-dialog__body ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .project-dialog__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(35 35 124 / 0.15);
  }
</style>
