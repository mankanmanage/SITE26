---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__main">
    <a href="/" class="footer__logo" aria-label="MANKAN — accueil">
      <img src="/images/logo/mankan-logo-creme.png" alt="MANKAN communication" width="160" height="82" loading="lazy" />
    </a>
    <ul class="footer__social" aria-label="Réseaux sociaux">
      {
        site.social.map((s) => (
          <li>
            <a href={s.url} rel="noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="footer__mail" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
  <div class="footer__bottom label--sm">
    <span>© {year} {site.name}</span>
    <span>{site.signature}</span>
    <a class="footer__legal" href="/mentions-legales/">Mentions légales</a>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 36px var(--pad) 24px;
    background: var(--bleu);
    color: var(--creme);
    border-top: 1px solid rgb(255 247 243 / 0.12);
  }
  .footer__main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .footer__logo img {
    height: 40px;
    width: auto;
  }
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .footer__social a,
  .footer__mail {
    display: inline-block;
    padding: 10px 0;
  }
  .footer__mail {
    font-size: 14px;
    color: var(--gris);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 16px;
    border-top: 1px solid rgb(255 247 243 / 0.12);
    color: var(--gris-2);
    letter-spacing: 0.12em;
  }
  .footer__legal:hover {
    color: var(--jaune);
  }
</style>
