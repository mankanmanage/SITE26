---
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div>
        <img
          src="/images/logo/mankan-logo-creme.png"
          alt="Mankan Communication"
          width="180"
          height="92"
          loading="lazy"
        />
        <p class="site-footer__sig quote">« {site.signature} »</p>
      </div>

      <nav aria-label="Pied de page">
        <ul>
          {nav.map((item) => <li><a class="link" href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <address>
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a><br />
        <a class="link" href={`tel:${site.phoneHref}`}>{site.phone}</a><br />
        {site.locality}, {site.country}
      </address>

      {
        site.social.length > 0 && (
          <ul class="site-footer__social">
            {site.social.map((s) => (
              <li>
                <a class="link" href={s.url} rel="noopener" target="_blank">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.name}</p>
      <button type="button" class="link site-footer__legal" data-open-dialog="mentions-legales">
        Mentions légales
      </button>
    </div>
  </div>

  <dialog id="mentions-legales" class="legal-dialog" aria-labelledby="mentions-titre">
    <div class="legal-dialog__inner">
      <button type="button" class="dialog-close" data-close-dialog aria-label="Fermer">×</button>
      <h2 id="mentions-titre">Mentions légales</h2>
      <h3>Éditeur</h3>
      <p>
        {site.name} — {site.locality}, {site.country}.<br />
        <!-- À compléter : raison sociale, forme juridique, numéro RCCM/NIF, responsable de publication. -->
        Contact : <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <h3>Hébergement</h3>
      <p>
        LWS (Ligne Web Services).
        <!-- À compléter : coordonnées complètes de l'hébergeur. -->
      </p>
      <h3>Données personnelles</h3>
      <p>
        Les informations envoyées via le formulaire de contact servent uniquement à répondre à votre
        demande. Elles ne sont ni vendues ni transmises à des tiers. Pour toute question ou demande
        de suppression, écrivez-nous à <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <h3>Propriété intellectuelle</h3>
      <p>
        Les contenus de ce site (textes, images, films, logos) sont la propriété de {site.name} ou
        de ses clients et ne peuvent être réutilisés sans autorisation.
      </p>
    </div>
  </dialog>
</footer>

<style>
  .site-footer {
    background: var(--noir);
    color: var(--creme);
    padding-block: 4rem 2rem;
    font-size: 1rem;
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.4fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgb(255 247 243 / 0.2);
  }
  .site-footer__top img {
    width: 150px;
    height: auto;
  }
  .site-footer__sig {
    margin-top: 1rem;
    font-size: 1.125rem;
    opacity: 0.85;
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  address {
    font-style: normal;
    line-height: 1.9;
  }
  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    font-size: 0.9375rem;
    opacity: 0.8;
  }
  .site-footer__bottom p {
    margin: 0;
  }
  .site-footer__legal {
    border: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  @media (max-width: 760px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
    .site-footer__bottom {
      flex-direction: column;
    }
  }

  .legal-dialog {
    max-width: min(720px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--creme);
    color: var(--noir);
  }
  .legal-dialog::backdrop {
    background: rgb(0 0 12 / 0.7);
  }
  .legal-dialog__inner {
    position: relative;
    padding: clamp(1.5rem, 4vw, 3rem);
    font-size: 1rem;
  }
  .legal-dialog h2 {
    margin-bottom: 1.5rem;
    color: var(--bleu);
  }
  .legal-dialog h3 {
    margin: 1.5rem 0 0.5rem;
    font-family: var(--font-body);
    font-size: 1.0625rem;
  }
</style>
