---
import Rays from './Rays.astro';
interface Props {
  title?: string;
}
const { title = 'Un projet à faire voir et à faire raconter\u00a0? Parlons-en.' } = Astro.props;
---

<section class="cta section section--bleu" aria-labelledby="cta-titre">
  <div class="container cta__inner">
    <Rays class="cta__rays" />
    <h2 id="cta-titre" data-reveal>{title}</h2>
    <div data-reveal style="--i:1">
      <a class="btn" href="/contact/#devis">Demander un devis <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    position: relative;
    display: grid;
    gap: 2.5rem;
    justify-items: start;
  }
  .cta h2 {
    max-width: 18ch;
    font-size: clamp(2rem, 4.5vw + 0.5rem, 4.5rem);
  }
  .cta :global(.cta__rays) {
    position: absolute;
    top: -1rem;
    right: var(--gutter);
    font-size: clamp(4rem, 10vw, 8rem);
    color: var(--orange);
  }
  .cta .btn:hover {
    border-color: var(--creme);
  }
</style>
