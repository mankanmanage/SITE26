# Configuration Apache pour l'hébergement LWS

# Page d'accueil : index.html (et non l'index.php de l'ancien WordPress)
DirectoryIndex index.html

# Forcer HTTPS et le domaine sans www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://mankancommunication.com%{REQUEST_URI} [L,R=301]

# Anciennes adresses du site → nouvelles pages
RewriteRule ^projects/?$ https://mankancommunication.com/projets/ [L,R=301]
RewriteRule ^portfolio/.*$ https://mankancommunication.com/projets/ [L,R=301]
RewriteRule ^films/(.*)$ https://mankancommunication.com/projets/$1 [L,R=301]
RewriteRule ^about/?$ https://mankancommunication.com/a-propos/ [L,R=301]
RewriteRule ^(conditions-utilisations|politique-de-confidentialite)/?$ https://mankancommunication.com/mentions-legales/ [L,R=301]

# Dossiers sans « / » final : redirection directe en https (évite un détour par http)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ https://mankancommunication.com/$1/ [L,R=301]

# Pages de l'ancien WordPress qui n'existent plus (articles de démonstration, maintenance) :
# « 410 Gone » indique à Google de les retirer de ses résultats.
RewriteRule ^(bonjour-tout-le-monde|spotlight-equinox-collection-by-shane-griffin|random-explorations-with-cinema-4d-and-redshift|visually-identity-and-branding-for-uk-restaurant|duis-tristique-condimentum-2|blog-post-with-image|meet-the-new-web-design-trends|motion-design|minimalistic-design|clean-web-design|quote-post|maintenance-mode|sample-page|feed|comments/feed|category/.*|tag/.*|author/.*)/?$ - [G,L]
RewriteRule ^(wp-sitemap.*\.xml|sitemap_index\.xml|.*-sitemap\.xml)$ - [G,L]

# Ancien WordPress : interface et API fermées au public (le site actuel ne s'en sert pas)
RewriteRule ^(wp-admin|wp-includes|wp-json)(/.*)?$ - [G,L]
RewriteRule ^(xmlrpc|wp-login|wp-signup|wp-trackback|wp-cron|wp-comments-post|wp-links-opml|wp-mail|wp-activate)\.php$ - [G,L]
RewriteCond %{QUERY_STRING} (^|&)(rest_route|p|page_id|s|cat|author|feed)= [NC]
RewriteRule ^(index\.php)?$ https://mankancommunication.com/? [L,R=301]

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  # Les vidéos, sons, images et polices restent en mémoire dans le téléphone (30 jours)
  <FilesMatch "\.(mp4|mp3|jpg|jpeg|png|webp|woff2|otf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Vidéos : type MIME correct pour la lecture dans le navigateur
AddType video/mp4 .mp4
